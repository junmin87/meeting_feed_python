# 이미지에 들어가면 안 되는 것들 (빌드 컨텍스트에서 제외)

# 가상환경 — 컨테이너 안에서 새로 설치하므로 불필요하고, 로컬(macOS)용 바이너리라 오히려 해롭다
venv/
.venv/

# 환경변수(시크릿) — 절대 이미지에 포함하지 않는다. 배포 시 환경변수로 주입한다.
.env
.env.*

# 파이썬 캐시/빌드 산출물
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 테스트/도구 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 모델 캐시(Whisper 가중치) — 이미지에 굽지 않고 런타임에 받거나 볼륨으로 마운트한다
.cache/
models/

# 버전 관리/문서
.git/
.gitignore
.dockerignore
Dockerfile
README.md
CLAUDE.md

# OS/에디터
.DS_Store
.idea/
.vscode/
